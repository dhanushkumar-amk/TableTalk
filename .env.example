# TableTalk Backend Configuration

# Port on which the HTTP server listens (default: 8080)
PORT=8080

# Comma-separated list of allowed origins for DNS rebinding protection and CORS
# Requests without an Origin header (curl, non-browser clients, Alexa+) are always permitted.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Logging filter directives (default: info,tabletalk_backend=debug)
RUST_LOG=info,tabletalk_backend=debug

# SQLite Database connection string (default: sqlite://data/tabletalk.db)
DATABASE_URL=sqlite://data/tabletalk.db

# Whether to automatically seed database on startup if empty (default: false)
SEED_ON_START=false

# Restaurant timezone override (default: Asia/Kolkata)
RESTAURANT_TZ=Asia/Kolkata

# AWS & Amazon Bedrock Configuration
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# LLM Orchestrator Configuration
# Options: groq | bedrock (default: groq)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
